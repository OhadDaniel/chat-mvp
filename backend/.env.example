# Secret used to sign JWTs. Min 32 chars — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Postgres connection string (local brew install: your mac user, no password)
DATABASE_URL=postgres://your-username@localhost:5432/chat_mvp

PORT=3001

# Optional — defaults shown
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=10
