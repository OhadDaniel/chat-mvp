
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars


# Week 7 needs MongoDB Atlas (mongodb+srv://...) — local Mongo has no Vector Search
MONGO_URI=mongodb://127.0.0.1:27017/chat_mvp?replicaSet=rs0

PORT=3001

JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=10

# AWS S3 (private bucket) + CloudFront for avatar storage
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=your-iam-access-key-id
AWS_SECRET_ACCESS_KEY=your-iam-secret-access-key
AVATAR_BUCKET=chat-mvp-avatars-dev
AVATAR_PUBLIC_BASE_URL=https://your-distribution.cloudfront.net

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
